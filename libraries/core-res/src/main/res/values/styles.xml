<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SkyCast" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/main_bg</item>
        <item name="android:statusBarColor">@color/sky_top</item>
        <item name="android:navigationBarColor">@color/sky_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/main_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">@android:color/transparent</item>
    </style>

    <style name="SplashTheme" parent="Theme.SkyCast">
        <item name="android:windowBackground">@color/main_bg</item>
        <item name="android:statusBarColor">@color/sky_top</item>
        <item name="android:navigationBarColor">@color/sky_bottom</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/main_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">@android:color/transparent</item>
    </style>
</resources>
